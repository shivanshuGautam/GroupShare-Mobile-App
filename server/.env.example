# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual environment values.
# DO NOT commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Local MongoDB: mongodb://localhost:27017/groupshare_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_DB_URI=mongodb://localhost:27017/groupshare_db
MONGO_URI=mongodb://localhost:27017/groupshare_db
USE_MEMORY_FALLBACK_IF_NO_MONGO=true

# Authentication (JSON Web Token)
# Replace with a strong, random secret string in production
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Cloudinary Storage (Optional / File Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Configuration (Nodemailer)
# For Gmail, use an App Password generated from your Google Account security settings
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_app_specific_password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM="GroupShare App" <no-reply@groupshare.local>
